{
  "name": "@xucroyuri/dsh-model-manager",
  "version": "0.2.0",
  "description": "Manage enabled model allowlists in DeepSeek Harness to keep model pickers clean.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "bin",
    "examples",
    "specs",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "CONTRIBUTING.zh.md",
    "SECURITY.md",
    "SECURITY.zh.md",
    "LICENSE",
    "AUTHORS.md",
    "CODE_OF_CONDUCT.md"
  ],
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "model-manager",
    "allowlist",
    "llm",
    "models"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/XucroYuri/dsh-model-manager.git"
  },
  "bugs": {
    "url": "https://github.com/XucroYuri/dsh-model-manager/issues"
  },
  "homepage": "https://github.com/XucroYuri/dsh-model-manager#readme",
  "author": "XucroYuri",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "dsh-model-manager": "bin/dsh-model-manager.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepublishOnly": "node --check src/index.js && for f in bin/*.js; do node --check \"$f\"; done",
    "test": "PYTHONPATH=src python3 -m unittest discover -s tests -p 'test_*.py' -v",
    "check": "node --check src/index.js",
    "pack:check": "npm pack --dry-run",
    "smoke": "bash scripts/smoke-test.sh"
  },
  "sideEffects": false
}
